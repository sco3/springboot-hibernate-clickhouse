meta {
  name: Create Event
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/events
  body: json
  auth: none
}

body:json {
  {
    "source": "test-service",
    "severity": "WARN",
    "message": "integration test event"
  }
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("has id and correct severity", function() {
    expect(res.body.id).to.be.a('string').and.not.empty;
    expect(res.body.severity).to.equal("WARN");
    expect(res.body.createdAt).to.be.a('string');
    bru.setVar("eventId", res.body.id);
  });
}